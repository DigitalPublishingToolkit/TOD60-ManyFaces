					<Cell Self="u3bfi435i3f" Name="3:13" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell" AppliedCellStylePriority="0" VerticalJustification="CenterAlign" LeftEdgeStrokePriority="69" RightEdgeStrokePriority="70" TopEdgeStrokePriority="69" BottomEdgeStrokePriority="74">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Coordination and governance</Content>
							</CharacterStyleRange>
