					</Cell>
					<Cell Self="u3bfi435i42" Name="1:14" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell" AppliedCellStylePriority="0" VerticalJustification="CenterAlign" LeftEdgeStrokePriority="88" RightEdgeStrokePriority="73" TopEdgeStrokePriority="72" BottomEdgeStrokePriority="77">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
