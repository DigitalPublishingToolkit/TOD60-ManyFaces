					<Cell Self="u3bfi435i3d" Name="1:13" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell" AppliedCellStylePriority="0" VerticalJustification="CenterAlign" LeftEdgeStrokePriority="88" RightEdgeStrokePriority="68" TopEdgeStrokePriority="67" BottomEdgeStrokePriority="72">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Tech/AI companies</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi435i3e" Name="2:13" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell" AppliedCellStylePriority="0" VerticalJustification="CenterAlign" LeftEdgeStrokePriority="68" RightEdgeStrokePriority="69" TopEdgeStrokePriority="68" BottomEdgeStrokePriority="73">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Responsibility and trustworthiness</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
