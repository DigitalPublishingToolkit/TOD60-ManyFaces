						<Link Self="u81e" AssetURL="$ID/" AssetID="$ID/" LinkResourceURI="file:/Users/orczi96/Documents/GitHub/TOD60-ManyFaces/imgs/figure7.1.png" LinkResourceFormat="$ID/Portable Network Graphics (PNG)" StoredState="Normal" LinkClassID="35906" LinkClientID="257" LinkResourceModified="false" LinkObjectModified="false" ShowInUI="true" CanEmbed="true" CanUnembed="true" CanPackage="true" ImportPolicy="NoAutoImport" ExportPolicy="NoAutoExport" LinkImportStamp="file 134196998619734304 141031" LinkImportModificationTime="2026-04-03T16:24:21" LinkImportTime="2026-04-03T16:27:07" LinkResourceSize="0~226e7" RenditionData="Actual" />
						<MetadataPacketPreference>
