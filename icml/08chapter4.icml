			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Br />
			</CharacterStyleRange>
			<EndnoteRange Self="u63c" SourceEndnote="u63b">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	As one of the few examples, see S. Yates and E. Carmi</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>, Developing Citizens Data Literacy: A Short Guide</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> (London: Nuffield Foundation, 2022).﻿</Content>
				</CharacterStyleRange>
			</EndnoteRange>
