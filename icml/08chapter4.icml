						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Algorithmic imaginary</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi3fci5" Name="2:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell" AppliedCellStylePriority="0" FillColor="Swatch/None" LeftEdgeStrokeWeight="0.5" RightEdgeStrokeWeight="0.5" TopEdgeStrokeWeight="0.5" BottomEdgeStrokeWeight="0.5" LeftEdgeStrokeColor="Color/Black" TopEdgeStrokeColor="Color/Black" RightEdgeStrokeColor="Color/Black" BottomEdgeStrokeColor="Color/Black" LeftEdgeStrokePriority="34" RightEdgeStrokePriority="34" TopEdgeStrokePriority="34" BottomEdgeStrokePriority="34">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>‘ways of thinking about what algorithms are, what they should be and how they function’</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
