	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 17" Name="URL 17" DestinationURL="http://www.dhs.gov/sites/default/files/publications/Tunnel%20Detection-Going%20Underground%20to%20Enhance%20Security.pdf" Hidden="false" DestinationUniqueKey="119" />
	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 18" Name="URL 18" DestinationURL="https://www.ice.gov/news/releases/us-mexican-authorities-shut-down-smuggling-tunnel-under-construction-nogales" Hidden="false" DestinationUniqueKey="120" />
	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 19" Name="URL 19" DestinationURL="http://www.utsandiego.com/news/2014/apr/04/cross-border-drug-tunnels-investigation/" Hidden="false" DestinationUniqueKey="121" />
	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 20" Name="URL 20" DestinationURL="http://www.ice.gov/news/releases/nogales-tunnel-task-force-shuts-down-drug-tunnel-backyard-shed" Hidden="false" DestinationUniqueKey="122" />
	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 21" Name="URL 21" DestinationURL="https://www.ice.gov/news/releases/us-mexican-authorities-shut-down-smuggling-tunnel-under-construction-nogales" Hidden="false" DestinationUniqueKey="123" />
