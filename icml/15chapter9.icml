			<EndnoteRange Self="u65b" SourceEndnote="u65a">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	‘Commitment 41’, in </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>The Strengthened Code of Practice on Disinformation 2022</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>, https://ec.europa.eu/newsroom/dae/redirection/document/87585 (accessed 14 February 2023).﻿</Content>
				</CharacterStyleRange>
