	<HyperlinkURLDestination Self="HyperlinkURLDestination/URL 10" Name="URL 10" DestinationURL="http://ec.europa.eu/priorities/digital-single-market/access/index_en.html" Hidden="false" DestinationUniqueKey="112" />
