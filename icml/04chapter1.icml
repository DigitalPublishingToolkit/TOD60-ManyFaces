				<EndnoteRange Self="u886" SourceEndnote="u885">
					<Content>﻿<?ACE 4?>	Omar Suleiman, ‘Erasing Palestine’, Al Jazeera, 19 Oct 2023, https:// www.aljazeera.com/opinions/2023/10/19/erasing-palestine-2 (accessed 15 November 2023).﻿</Content>
				</EndnoteRange>
