			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<EndnoteRange Self="ubf5" SourceEndnote="ubf4">
					<Content>﻿<?ACE 4?>	‘AU Data Policy Framework’, 24.﻿</Content>
