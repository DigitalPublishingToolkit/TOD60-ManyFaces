				<EndnoteRange Self="ubca" SourceEndnote="ubc9">
					<Content>﻿<?ACE 4?>	‘Search and Compare Data Protection Legislation’, DS-I Africa, https:// www.datalaw.africa/law/search_compare (accessed 15 December 2024).﻿</Content>
				</EndnoteRange>
				<Br />
				<EndnoteRange Self="ubcc" SourceEndnote="ubcb">
					<Content>﻿<?ACE 4?>	South Africa’s Protection of Personal Information Act (Act no. 4 of 2013).﻿</Content>
				</EndnoteRange>
				<Br />
				<EndnoteRange Self="ubce" SourceEndnote="ubcd">
					<Content>﻿<?ACE 4?>	Ghana, Data Protection Act, 2012 (Act 843), published in the Ghana Gazette No. 39, 16 October 2012.﻿</Content>
				</EndnoteRange>
				<Br />
