			<EndnoteRange Self="ubd0" SourceEndnote="ubcf">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>In terms of DA, Articles 14 and 15.﻿</Content>
