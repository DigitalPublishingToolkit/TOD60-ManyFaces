				<Br />
			</CharacterStyleRange>
			<EndnoteRange Self="u605" SourceEndnote="u604">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	Maurice Stucke and Allen Grunes, </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>Big Data and Competition Policy</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> (Oxford University Press, 2016).﻿</Content>
				</CharacterStyleRange>
			</EndnoteRange>
