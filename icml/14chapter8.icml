				<Br />
			</CharacterStyleRange>
			<EndnoteRange Self="u609" SourceEndnote="u608">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	Tommaso Venturini and Richard Rogers, ‘“API-Based Research” or How Can Digital Sociology and Journalism Studies Learn from the Facebook and Cambridge Analytica Data Breach’, </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>Digital Journalism</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> 532, no. 7 (2019): 532–540; Axel Bruns, ‘After the “APIcalypse”: Social Media Platforms and Their Fight against Critical Scholarly Research’, </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>Information, Communication and Society</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> 1544, no. 22 (2019): 14–36.﻿</Content>
				</CharacterStyleRange>
			</EndnoteRange>
