				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
				<Content>Figure 8.2</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content> Frequencies of types and data specialization of DIS.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aParagraph">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
				<Content>Source</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>: Prepared by the author.</Content>
				<Br />
				<Content>Widely cited examples of these indexes are the Five-Star Model of data availability,</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u677" EndnoteTextRange="u678" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content> composed of five levels depending on whether data is available on the web with an open licence, machine-readable, using non-proprietary file formats, using open standards, or linked to other people’s data for context; the Four-Stage Model of data availability,</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u679" EndnoteTextRange="u67a" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content> composed of four levels depending on whether a government offers a description of the procedure to access information, data available in a non-reusable and non-machine-readable format, data available in a reusable and machine-readable format, or data visualizable with predefined tools; and the Open Knowledge Foundation model, which scores data openness according to whether data is produced in digital format, publicly available, free of charge, available online, openly licensed, machine-readable, available in bulk, or updated.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u67d" EndnoteTextRange="u67e" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content> Finally, in the last years, the FAIR principles have diffused as guidance for scientific data management and stewardship; they promote findable, accessible, interoperable, and reusable data.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u680" EndnoteTextRange="u681" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default" Position="Superscript">
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>Drawing inspiration from these models, I first created a draft list of features that could be observed in DISs to measure their ‘openness’ vis-à-vis academic researchers (the draft list is available in Table 8A.2 [Appendix 8A]). Then I analysed the website and documentation (that is, white papers, slideshows, explanatory material, and so on) of every DIS in the dataset. To make the research more accurate, I used the Google search engine to scrape the websites’ content by using the following keywords: ‘research’, ‘academic’, and ‘university’. Where no English version of the material was available, I relied on online translation services. Through an inductive process, I removed from the list the features that did not appear in any DISs and added features that were not included in the initial list. The final list includes three features that have been observed in existing DISs and are outlined in Table 8.1.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
				<Content>Table 8.1</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content> Features used to assess the DISs’ research openness</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/TableCaption">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Table Self="u3bfi42d" HeaderRowCount="1" FooterRowCount="0" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" BodyRowCount="3" ColumnCount="3" AppliedTableStyle="TableStyle/Table" TableDirection="LeftToRightDirection">
					<Row Self="u3bfi42dRow0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleRowHeight="15.460891963928704" />
					<Row Self="u3bfi42dRow1" Name="1" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleRowHeight="58.660891963928705" />
					<Row Self="u3bfi42dRow2" Name="2" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleRowHeight="47.860891963928694" />
					<Row Self="u3bfi42dRow3" Name="3" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleRowHeight="69.4608919639287" />
					<Column Self="u3bfi42dColumn0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleColumnWidth="67.75067750677506" />
					<Column Self="u3bfi42dColumn1" Name="1" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleColumnWidth="112.72176343810682" />
					<Column Self="u3bfi42dColumn2" Name="2" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleColumnWidth="162.23622047244103" />
					<Cell Self="u3bfi42di9" Name="0:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="19" RightEdgeStrokePriority="18" TopEdgeStrokePriority="19" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
								<Content>Feature</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42dia" Name="1:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="18" TopEdgeStrokePriority="19" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
								<Content>Description</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42dib" Name="2:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="19" TopEdgeStrokePriority="19" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
								<Content>Rationale</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di0" Name="0:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="19" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Data access mention</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di1" Name="1:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>The possibility for researchers and academic institutions to access data from the project is explicitly mentioned.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di2" Name="2:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="19" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Mentioning the possibility of data access for research purposes suggests that academic needs have been considered during the design of the DIS and support for researchers is available.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di3" Name="0:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="19" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Dedicated data access</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di4" Name="1:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Research or academic institutions are provided with dedicated procedures to access data.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di5" Name="2:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="19" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="18">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Dedicated procedures facilitate accessing and tailoring the data for research purposes.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di6" Name="0:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="19" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="19">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>Documented implementation in a research project</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di7" Name="1:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="18" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="19">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>The data accumulated by the initiative has been employed in documented research activity by researchers or academic institutions.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u3bfi42di8" Name="2:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/Cell Style 1" AppliedCellStylePriority="1" LeftEdgeStrokePriority="18" RightEdgeStrokePriority="19" TopEdgeStrokePriority="18" BottomEdgeStrokePriority="19">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3atext table">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
								<Content>The existence of projects using the DIS’s data demonstrates the accessibility of such data for research purposes and possibly suggests dedicated tracks to access data.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aParagraph">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
				<Content>Source</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>: Compiled by the author.</Content>
				<Br />
				<Content>I report here some examples, drawn from the dataset to better expl</Content>
				<Content>ain each feature, together with snippets taken from the DISs’ websites:</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
				<Content>Data access mention</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>: Patients Know Best and Gezondheidsmeter are services through which patients can create a record of their health data and share them with healthcare providers. The websites of these services explicitly mention that patients can give consent to share their data with medical research groups and institutions.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aBlockquote">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>With Patients Know Best patients can give direct consent to share their information for research purposes. Organisations can select the institutions to work with and help share this data seamlessly in real-time with those selected research groups and associations.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u684" EndnoteTextRange="u685" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default" Position="Superscript">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aParagraph">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic" ParagraphBreakType="NextPage">
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic" FontStyle="Bold">
				<Content>Dedicated data access</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default" FontStyle="Bold">
				<Content>: </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>Seedlinked is a platform that allows growers to run seed variety trials. The platform offers a dedicated option to allow university researchers to create and study the trials. The service Selfcare allows users to integrate the measurement data from various devices in a ‘personal health environment’. With the consent of the users, researchers can obtain data on a targeted population across a certain period.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aBlockquote">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>Research using wearables with which participants can carry out measurements themselves in their own (home) environment is becoming increasingly important. With the use of SelfcareResearch, this data comes to the researcher in an automated manner. As a researcher you have access to a dashboard where you can export the research data 24/7.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u686" EndnoteTextRange="u687" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default" Position="Superscript">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aParagraph">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic" FontStyle="Bold">
				<Content>Documented access for research purposes</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>: BitsaboutMe and CitizenMe are services that allow consumers to provide data about their purchasing behaviour and lifestyle, and to share anonymized information to earn money. These services have been used by the University of Zurich and University of Leeds to conduct research on the changes in consumer habits and preferences.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aText%3aBlockquote">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
				<Content>To participate in the research project … you agree to share your purchase history of Coop and/or Migros (or REWE in Germany) with the research group. This will be done completely anonymously, so no personal data such as name, email, etc. will be transmitted.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Position="Superscript">
				<Endnote Self="u688" EndnoteTextRange="u689" />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default" Position="Superscript">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Page &gt; Running Text%3aImages%3aImg caption">
