			<EndnoteRange Self="u5fa" SourceEndnote="u5f9">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	Katharina Pistor, ‘Rule by Data: The End of Markets?’ </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>Law and Contemporary Problems</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> 101, no. 83 (2020): 101–124.﻿</Content>
				</CharacterStyleRange>
