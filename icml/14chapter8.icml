					<Row Self="u3bfi495Row0" Name="0" TextTopInset="8.503937007874017" TextLeftInset="5.669291338582678" TextBottomInset="2.834645669291339" TextRightInset="2.834645669291339" ClipContentToTextCell="false" SingleRowHeight="18.295537633220043" />
