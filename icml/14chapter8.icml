						<MetadataPacketPreference>
							<Properties>
								<Contents><![CDATA[<?xpacket begin="﻿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 9.1-c002 79.b7c64cc, 2024/07/16-07:59:40        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#">
         <xmp:CreatorTool>Adobe Photoshop 26.2 (Macintosh)</xmp:CreatorTool>
         <xmp:CreateDate>2026-02-14T09:19:48+01:00</xmp:CreateDate>
         <xmp:ModifyDate>2026-04-03T16:29:50+02:00</xmp:ModifyDate>
         <xmp:MetadataDate>2026-04-03T16:29:50+02:00</xmp:MetadataDate>
         <dc:format>image/png</dc:format>
         <photoshop:ColorMode>1</photoshop:ColorMode>
         <xmpMM:InstanceID>xmp.iid:e823b932-8cfa-471a-bd21-1eed337c692c</xmpMM:InstanceID>
         <xmpMM:DocumentID>xmp.did:e823b932-8cfa-471a-bd21-1eed337c692c</xmpMM:DocumentID>
         <xmpMM:OriginalDocumentID>xmp.did:e823b932-8cfa-471a-bd21-1eed337c692c</xmpMM:OriginalDocumentID>
