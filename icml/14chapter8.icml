			</CharacterStyleRange>
			<EndnoteRange Self="u607" SourceEndnote="u606">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content>﻿<?ACE 4?>	Viktor Mayer-Schönberger and Thomas Ramge, </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Italic">
					<Content>Reinventing Capitalism in the Age of Big Data</Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Default">
					<Content> (Basic Books, 2018).﻿</Content>
				</CharacterStyleRange>
			</EndnoteRange>
