					<Leading type="unit">10.8</Leading>
				</Properties>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
				<Properties>
					<Leading type="unit">10.8</Leading>
				</Properties>
				<Content>Appendix 8A Table 8A.1 </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold" FontStyle="Regular">
				<Properties>
					<Leading type="unit">10.8</Leading>
				</Properties>
				<Content>Dataset of data intermediation services accessible in the territory of the EU and the UK, 2000-2022</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Bold">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
